{
  "name": "dsh-remote-gateway",
  "version": "0.2.0",
  "description": "DSH settings > Remote Gateway: approve pending devices and manage the trusted-device whitelist; bundles the whitelist-based sidecar gateway (no password, device approval, admin on loopback-only port).",
  "author": "Suluo0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "sidecar",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=0.0.1-rc.1"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "pack": "npm run build:sidecar && npm pack"
  },
  "license": "MIT"
}
